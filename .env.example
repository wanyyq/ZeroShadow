# ===== ZeroShadow 服务配置 =====
# 服务端口（ssh -R 80:localhost:12345 依赖此端口）
PORT=12345
# 监听地址：0.0.0.0 表示局域网可访问（默认一直开启）
HOST=0.0.0.0

# ===== 超级管理员（唯一，且只能在此修改）=====
SUPER_ADMIN_USER=admin
# 修改密码后需重启服务，旧登录会话将全部失效
SUPER_ADMIN_PASSWORD=change-me

# ===== 会话 =====
# 登录会话有效期（小时）
SESSION_HOURS=72

# ===== 客户端 IP 解析 =====
# 反向代理 / SSH 隧道（serveo、pinggy 等）会把请求源变成 127.0.0.1，导致日志里的
# IP 失去意义、且 IP 维度的失败限速会误伤所有人。上述场景下开启本项：
# TRUST_PROXY=loopback          # 信任来自本机代理的 X-Forwarded-For（推荐用于隧道）
# TRUST_PROXY=1                 # 或按跳数
# TRUST_PROXY=10.0.0.0/8        # 或按网段（可逗号分隔多个）
# 注意：开启后会依据 X-Forwarded-For 判定客户端 IP；如果服务同时能被公网直连
# （不经过代理），攻击者就能伪造该头来绕过限速，此时请保持关闭（默认）。

# ===== 存储 =====
# 网盘文件根目录（留空则使用 ./data/files）
# FILES_DIR=D:\ZeroShadowFiles

# ===== 外部映射目录（只读虚拟文件夹，JSON 格式）=====
# 将服务器其他路径映射为网盘根目录只读文件夹
# 路径使用 / 或 \\ 均可（Windows 反斜杠会自动转换）
# ⚠️ 不要映射服务自身所在目录（尤其不要写 "./"）——那里有 .env（超管明文密码）与
#    data/（会话签名密钥、口令哈希、日志、备份）。这类路径已在服务端被硬性拦截，
#    但映射整个项目目录本身也没有任何好处。
# FILES_SOFT_DIR={"软件文件夹":"D:/MyFiles","工作目录":"D:\\Program\\xxx"}

# ===== 静默模式 =====
# NOLOG=true 禁止控制台输出，日志仅写入文件（超管后台"日志"可查看）
# 也可启动时加 CLI 参数：node server/index.js -nolog
# 注意：通过 pnpm 需加 -- 传参：pnpm start -- -nolog
# NOLOG=true

# ===== WebDAV 挂载（v2.0 起为正式功能，默认关闭）=====
# 开关与挂载路径都在后台「设置 → 公网 → WebDAV」里，实时生效、不需要重启。
# 这两行只在 data/config.json 里还没有对应字段时作为默认值；
# 后台一旦保存过，就以 data/config.json 为准。
# ⚠️ 风险提示（务必阅读）：
#   1. WebDAV 客户端普遍只支持 HTTP Basic 认证 —— 用户名密码会在**每一个请求**
#      里重复发送。请只在 HTTPS 或完全可信的内网下使用，不要直接暴露到公网。
#   2. 只接受**成员账号**（bcrypt）；刻意不接受超级管理员账号，也不接受浏览器
#      Cookie 会话（否则任意网页都能借登录态发起 DAV 请求，等于绕过 CSRF）。
#   3. 各客户端的协议实现差异很大，行为无法像普通接口那样被完整覆盖。
# WEBDAV=1
# WEBDAV_PATH=/dav

# ===== 链接下载工具（download-url）安全开关 =====
# 默认禁止下载内网 / 回环 / 链路本地 / 云元数据地址（防止 SSRF 探测内网）
# 如果确实需要用网盘去抓取内网文件，按需显式放开其中一项：
# DOWNLOAD_URL_ALLOW_PRIVATE=1                        放开全部内网地址（谨慎，等于把内网暴露给有下载权限的人）
# DOWNLOAD_URL_ALLOW_HOSTS=nas.local,192.168.1.10     只放开指定主机（更安全）
# 目标站点使用自签名证书时可跳过校验（不推荐，会失去中间人防护）：
# DOWNLOAD_URL_INSECURE_TLS=1

# ===== 文件转换（v2.1）：md → PDF 用的中文字体（可选）=====
# 转换 PDF 时按平台自动找系统中文字体（Windows: 微软雅黑 / 黑体 / 等线 / 宋体；
# macOS: 苹方；Linux: 文泉驿 / Droid）。也可以把字体文件放进 data/fonts/ 目录，
# 服务会自动发现。部署环境一个中文字体都没有时，PDF 里的中文会显示成「?」，
# 转换本身仍然成功（任务提示里会写明）。
# 只支持 TrueType 轮廓（.ttf / .ttc）；CFF 轮廓的 .otf 会被跳过。
# 顺序：CONVERT_PDF_FONT → data/fonts/*.ttf|ttc → 系统字体
# CONVERT_PDF_FONT=D:\fonts\SourceHanSansSC-Regular.ttf
